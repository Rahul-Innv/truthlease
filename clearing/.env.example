# Clearing — example configuration. Copy to .env.local; never commit real values.

# Reasoning mode: "local" (deterministic rules, default), "live" (Anthropic-backed
# request interpretation and counteroffer suggestion; needs ANTHROPIC_API_KEY), or
# "zoowork" (the planner/buyer role runs on ZooWork Managed Agents; needs ZOOWORK_API_KEY).
CLEARING_REASONING=local
ANTHROPIC_API_KEY=
# Model used only in live mode. Verify availability with your provider account.
CLEARING_MODEL=claude-opus-5-5
# Hard ceilings for live mode (calls include retries).
CLEARING_MAX_MODEL_CALLS=16
CLEARING_MAX_CONCURRENT_MODEL_CALLS=4
CLEARING_MODEL_TIMEOUT_MS=20000

# Readability pacing between real supplier events in local mode (ms). 0 for tests.
CLEARING_PACE_MS=350

# Optional real supplier discovery (unverified candidates only). Absent = disabled.
TAVILY_API_KEY=

# Moss semantic supplier discovery (https://moss.dev; credentials from portal.usemoss.dev).
# Moss runs server-side here: the key never reaches the browser. Absent = a local
# deterministic keyword matcher is used instead. Discovery results are unverified
# candidates for display and are NEVER executable offers; the demo catalog alone can quote.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Sponsor integrations (recorded as "not connected" when absent).
ZOOWORK_API_KEY=
ZOOWORK_BASE_URL=
# Optional: reuse an existing ZooWork Agent instead of creating "clearing-planner".
ZOOWORK_AGENT_ID=
# Optional: a specific selectable model from the ZooWork catalog for the planner agent,
# e.g. a Novita-hosted open-source model (run `npx tsx scripts/zoowork-models.mts` to list).
ZOOWORK_MODEL=

# BAND coordination (https://app.band.ai). When BAND_BUYER_AGENT_ID and BAND_BUYER_API_KEY are
# both set, every concession ask goes to the seller's own agent through one BAND chat room
# (buyer @mentions seller, seller replies @mentioning buyer). Register one Remote Agent for the
# buyer and one per seller at app.band.ai/agents (copy each Agent UUID and its API key — the key
# is shown once). Run one seller process per merchant:
#   BAND_SELLER_MERCHANT=m-juniper BAND_AGENT_ID=<seller uuid> BAND_API_KEY=<seller key> \
#     BAND_BUYER_AGENT_ID=<buyer uuid> npx tsx scripts/band-seller.mts
BAND_BUYER_AGENT_ID=
BAND_BUYER_API_KEY=
# JSON map merchantId -> seller agent UUID. Unmapped merchants answer in-process (local fallback,
# reported in the status popover), e.g. {"m-juniper":"<uuid>","m-goldenhour":"<uuid>"}
BAND_SELLER_AGENTS=
# Optional: reuse an existing room (the buyer agent must be a participant) instead of creating one.
BAND_ROOM_ID=
# How long the buyer waits for each seller reply before treating the ask as declined (ms).
BAND_REPLY_TIMEOUT_MS=45000
# Optional endpoint overrides (SDK defaults: wss://app.band.ai/api/v1/socket, https://app.band.ai).
BAND_WS_URL=
BAND_REST_URL=

# SQLite file location (relative to the clearing/ directory).
CLEARING_DB_PATH=.data/clearing.sqlite

# Agent front door: external agents may submit requests and read plans. Approval
# stays with the organizer unless this is explicitly set to "true".
CLEARING_AGENT_CAN_APPROVE=false
